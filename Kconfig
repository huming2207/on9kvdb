menu "on9kvdb"

    config ON9KVDB_MAX_LIVE_DATA_SIZE
        int "Maximum encoded live data in bytes"
        default 2097152
        range 65536 4294967295
        help
            Maximum encoded size of the newest committed, non-tombstoned
            namespace/key records. This includes record metadata, namespace,
            key, type, and value bytes. Existing databases must match this
            build-time value exactly.

    config ON9KVDB_PROVISIONED_DATABASE_SIZE
        int "Total provisioned database size in bytes"
        default 4194304
        range 196608 4294967295
        help
            Exact sum of manifest, both WAL files, and every SSTable file.
            Every file is allocated contiguously at its final size. Existing
            databases must match this build-time value exactly.

    config ON9KVDB_WAL_FILE_SIZE
        int "Size of each WAL file in bytes"
        default 262144
        range 65536 4294967295
        help
            Final preallocated size of each of the two permanent WAL files.
            Must be a multiple of 4096 bytes.

    config ON9KVDB_SSTABLE_FILE_SIZE
        int "Size of each SSTable file in bytes"
        default 610304
        range 65536 4294967295
        help
            Final preallocated size of each permanent SSTable file. The
            default is 596 KiB. Must be a multiple of 4096 bytes.

    config ON9KVDB_SSTABLE_COUNT
        int "Number of permanent SSTable files"
        default 6
        range 2 64
        help
            Number of fixed physical SSTable slots. The FATFS mount must
            allow at least this value plus three on9kvdb file descriptors,
            in addition to descriptors required by the application.

    config ON9KVDB_RUNTIME_MEMORY_BUDGET
        int "Default component-owned runtime memory budget in bytes"
        default 102400
        range 32768 204799
        help
            Default memory budget used by on9kvdb_cfg. The v1 target is
            PSRAM and all runtime overrides must remain below 200 KiB.
            No component-owned allocation is allowed during normal operations
            after initialization completes.

    config ON9KVDB_REQUIRE_PSRAM
        bool "Require PSRAM for the bulk runtime arena"
        default y
        help
            Allocate the bounded bulk arena explicitly from PSRAM and fail
            initialization with ESP_ERR_NOT_SUPPORTED if PSRAM is unavailable.
            The 4096-byte I/O frame remains in internal DMA-capable RAM.

    config ON9KVDB_MAX_NAMESPACES
        int "Maximum durable namespaces"
        default 64
        range 1 1024
        help
            Maximum number of namespaces recoverable by this build. Existing
            databases must match this value exactly.

    config ON9KVDB_MAX_OPEN_HANDLES
        int "Maximum simultaneously open namespace handles"
        default 8
        range 1 256
        help
            Fixed generation-checked handle-table capacity. Existing databases
            must match this value exactly in v1.

    config ON9KVDB_MEMTABLE_ENTRY_COUNT
        int "Maximum Phase 3 memtable entries"
        default 512
        range 16 4096
        help
            Fixed open-addressed memtable index capacity. This must be a power
            of two. Existing databases must match this value exactly.

    config ON9KVDB_MEMTABLE_DATA_SIZE
        int "Memtable record arena size in bytes"
        default 36864
        range 8192 131072
        help
            Fixed byte capacity for newest committed memtable records and
            tombstones. This is a runtime arena limit, not total live database
            size.

    config ON9KVDB_TRANSACTION_STAGING_SIZE
        int "Maximum staged value bytes per transaction"
        default 24576
        range 8192 131072
        help
            Sum of value bytes staged by the one active transaction. Replacing
            the same key reclaims its previous staged bytes. Existing databases
            must match this value exactly.

    config ON9KVDB_MAX_TRANSACTION_MUTATIONS
        int "Maximum distinct keys per transaction"
        default 10
        range 1 10
        help
            A repeated mutation of the same key counts once. Existing databases
            must match this value exactly.

endmenu
